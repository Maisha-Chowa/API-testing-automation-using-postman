              "listen": "test",
              "script": {
                "exec": [
                  "// 1. Parse Response Body safely",
                  "let jsonData;",
                  "try {",
                  "    jsonData = pm.response.json();",
                  "} catch (e) {",
                  "    jsonData = {};",
                  "}",
                  "",
                  "// 2. Extract Data from CSV",
                  "// We convert the string \"true\"/\"false\" from the CSV into a real boolean",
                  "const isSuccessValue = String(pm.iterationData.get(\"isSuccess\")).toUpperCase();",
                  "const isSuccessCase = (isSuccessValue === \"TRUE\");",
                  "const description = pm.iterationData.get(\"description\");",
                  "console.log(\"isSuccessValue:\", isSuccessValue)",
                  "// 3. Status and Header Tests",
                  "pm.test(`Status is 200 for: ${description}`, function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Content-Type is JSON\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "// 4. Branching Logic using our new column",
                  "if (isSuccessCase) {",
                  "    // POSITIVE TEST PATH",
                  "    pm.test(\"SUCCESS: Token is present and valid\", function () {",
                  "        pm.expect(jsonData).to.have.property(\"token\");",
                  "        pm.expect(jsonData.token).to.be.a(\"string\").and.not.empty;",
                  "        ",
                  "        // Save the token for subsequent requests",
                  "        pm.environment.set(\"token\", jsonData.token);",
                  "    });",
                  "} else {",
                  "    // NEGATIVE TEST PATH",
                  "    pm.test(\"FAILURE: Correct error message returned\", function () {",
                  "        pm.expect(jsonData).to.have.property(\"reason\");",
                  "        pm.expect(jsonData.reason).to.equal(\"Bad credentials\");",
                  "        ",
                  "        // Security: Clear any existing token if login fails",
                  "        pm.environment.unset(\"token\");",
                  "    });",
                  "}",
                  "",
                  "// 5. Performance Test (Independent of outcome)",
                  "pm.test(\"Response time is acceptable\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});",
                  "",
                  "",
