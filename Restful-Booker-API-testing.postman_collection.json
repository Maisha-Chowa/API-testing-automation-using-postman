          "name": "PartialUpdateBooking",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const isEmptyBody = String(pm.iterationData.get(\"isEmptyBody\")).toLowerCase() === \"true\";",
                  "",
                  "if (isEmptyBody) {",
                  "    pm.variables.set(\"dynamicPatchBody\", \"{}\");",
                  "    console.log(\"TEST: Sending empty JSON {} for PATCH\");",
                  "} else {",
                  "    // 1. Initialize empty object",
                  "    let body = {};",
                  "",
                  "    // 2. Helper function",
                  "    function addIfPresent(csvKey, jsonKey, type) {",
                  "        let value = pm.iterationData.get(csvKey);",
                  "        // Only add if value is not undefined, not null, and not an empty string",
                  "        if (value !== undefined && value !== null && value !== \"\") {",
                  "            if (type === \"number\") body[jsonKey] = Number(value);",
                  "            else if (type === \"boolean\") body[jsonKey] = String(value).toLowerCase() === \"true\";",
                  "            else body[jsonKey] = value;",
                  "        }",
                  "    }",
                  "",
                  "    // 3. Map CSV columns",
                  "    addIfPresent(\"firstName\", \"firstname\", \"string\");",
                  "    addIfPresent(\"lastName\", \"lastname\", \"string\");",
                  "    addIfPresent(\"totalPrice\", \"totalprice\", \"number\");",
                  "    addIfPresent(\"depositPaid\", \"depositpaid\", \"boolean\");",
                  "",
                  "    // 4. Handle nested dates",
                  "    let checkin = pm.iterationData.get(\"checkin\");",
                  "    let checkout = pm.iterationData.get(\"checkout\");",
                  "",
                  "    if (checkin || checkout) {",
                  "        body.bookingdates = {};",
                  "        if (checkin) body.bookingdates.checkin = checkin;",
                  "        if (checkout) body.bookingdates.checkout = checkout;",
                  "    }",
                  "",
                  "    pm.variables.set(\"dynamicPatchBody\", JSON.stringify(body));",
                  "    console.log(\"PATCH Payload generated:\", JSON.stringify(body));",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const expectedStatusRaw = pm.iterationData.get(\"expectedStatus\");",
                  "const expectedStatus = expectedStatusRaw !== undefined && expectedStatusRaw !== null && expectedStatusRaw !== \"\"",
                  "  ? Number(expectedStatusRaw)",
                  "  : pm.response.code; // fallback so it doesn't become NaN when not running data-driven",
                  "",
                  "pm.test(`Status is ${expectedStatus}`, () => {",
                  "  pm.response.to.have.status(expectedStatus);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "  const schema = {",
                  "    type: \"object\",",
                  "    required: [\"firstname\", \"lastname\", \"totalprice\", \"depositpaid\", \"bookingdates\"],",
                  "    properties: {",
                  "      firstname: { type: \"string\" },",
                  "      lastname: { type: \"string\" },",
                  "      totalprice: { type: \"number\" },",
                  "      depositpaid: { type: \"boolean\" },",
                  "      bookingdates: {",
                  "        type: \"object\",",
                  "        required: [\"checkin\", \"checkout\"],",
                  "        properties: {",
                  "          checkin: { type: \"string\" },",
                  "          checkout: { type: \"string\" }",
                  "        }",
                  "      },",
                  "      additionalneeds: { type: \"string\" }",
                  "    }",
                  "  };",
                  "",
                  "  pm.test(\"Schema Validation for PATCH response\", () => {",
                  "    const result = tv4.validateResult(pm.response.json(), schema);",
                  "    pm.expect(result.valid, JSON.stringify(result.error)).to.be.true;",
                  "  });",
                  "",
                  "  pm.test(\"Verify patched value matches CSV (when provided)\", () => {",
                  "    const jsonData = pm.response.json();",
                  "",
                  "    const csvPrice = pm.iterationData.get(\"totalPrice\");",
                  "    if (csvPrice !== undefined && csvPrice !== null && csvPrice !== \"\") {",
                  "      pm.expect(jsonData.totalprice).to.equal(Number(csvPrice));",
                  "    }",
                  "  });",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
