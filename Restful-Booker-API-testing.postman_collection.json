    {
      "name": "Get Booking by ID",
      "item": [
        {
          "name": "GetBookingById",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 1. Define the Schema (Contract)",
                  "const schema = {",
                  "    \"type\": \"object\",",
                  "    \"required\": [\"firstname\", \"lastname\", \"totalprice\", \"depositpaid\", \"bookingdates\"],",
                  "    \"properties\": {",
                  "        \"firstname\": { \"type\": \"string\" },",
                  "        \"lastname\": { \"type\": \"string\" },",
                  "        \"totalprice\": { \"type\": \"number\" },",
                  "        \"depositpaid\": { \"type\": \"boolean\" },",
                  "        \"bookingdates\": {",
                  "            \"type\": \"object\",",
                  "            \"required\": [\"checkin\", \"checkout\"],",
                  "            \"properties\": {",
                  "                \"checkin\": { \"type\": \"string\", \"pattern\": \"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\" },",
                  "                \"checkout\": { \"type\": \"string\", \"pattern\": \"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\" }",
                  "            }",
                  "        }",
                  "    }",
                  "};",
                  "",
                  "// 2. Extract and Normalize data from CSV",
                  "const expectedStatus = Number(pm.iterationData.get(\"expectedStatus\"));",
                  "const isSuccessCase = String(pm.iterationData.get(\"isSuccess\")).toLowerCase() === \"true\";",
                  "const description = pm.iterationData.get(\"description\");",
                  "",
                  "// 3. Dynamic Test Case Branding",
                  "pm.test(`Description: ${description}`, () => {",
                  "    // This is a placeholder test to show the description in the results",
                  "    pm.expect(true).to.be.true;",
                  "});",
                  "",
                  "// 4. Status Code Assertion",
                  "pm.test(`Status code is ${expectedStatus}`, () => {",
                  "    pm.response.to.have.status(expectedStatus);",
                  "});",
                  "",
                  "// 5. Logic Branching",
                  "if (pm.response.code === 200 && isSuccessCase) {",
                  "    ",
                  "    pm.test(\"Schema Validation for Successful Response\", () => {",
                  "        const jsonData = pm.response.json();",
                  "        const result = tv4.validateResult(jsonData, schema);",
                  "        if (!result.valid) {",
                  "            console.log(\"Schema Error Details:\", result.error.message);",
                  "        }",
                  "        pm.expect(result.valid).to.be.true;",
                  "    });",
                  "",
                  "} else if (pm.response.code === 404) {",
                  "",
                  "    pm.test(\"Error Message Check\", () => {",
                  "        // Restful-Booker returns \"Not Found\" as plain text for 404",
                  "        pm.expect(pm.response.text()).to.include(\"Not Found\");",
                  "    });",
                  "",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseURL}}/booking/{{bookingId}}",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Create Booking",
      "item": [
        {
          "name": "CreateBooking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const schema = {",
                  "    \"type\": \"object\",",
                  "    \"required\": [\"bookingid\", \"booking\"],",
                  "    \"properties\": {",
                  "        \"bookingid\": { \"type\": \"number\" },",
                  "        \"booking\": {",
                  "            \"type\": \"object\",",
                  "            \"required\": [\"firstname\", \"lastname\", \"totalprice\", \"depositpaid\", \"bookingdates\"]",
                  "        }",
                  "    }",
                  "};",
                  "",
                  "const expectedStatus = Number(pm.iterationData.get(\"expectedStatus\"));",
                  "const description = pm.iterationData.get(\"description\");",
                  "",
                  "// 1. Status Check",
                  "pm.test(`Status should be ${expectedStatus} for: ${description}`, function () {",
                  "    pm.response.to.have.status(expectedStatus);",
                  "});",
                  "",
                  "// 2. Branching Logic",
                  "if (pm.response.code === 200) {",
                  "    let jsonData;",
                  "    try { jsonData = pm.response.json(); } ",
                  "    catch (e) { pm.expect.fail(\"Not valid JSON\"); }",
                  "",
                  "    pm.test(\"Schema Validation\", () => {",
                  "        const result = tv4.validateResult(jsonData, schema);",
                  "        pm.expect(result.valid).to.be.true;",
                  "    });",
                  "",
                  "    pm.test(\"Persistence: Store ID\", () => {",
                  "        pm.collectionVariables.set(\"last_booking_id\", jsonData.bookingid);",
                  "    });",
                  "",
                  "} else {",
                  "    // For 500 Errors",
                  "    pm.test(\"Negative Check: Response contains error message\", () => {",
                  "        pm.expect(pm.response.text()).to.be.oneOf([\"Internal Server Error\", \"Bad Request\"]);",
                  "    });",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// 1. Get iteration data",
                  "const isEmptyBody = String(pm.iterationData.get(\"isEmptyBody\")).toLowerCase() === \"true\";",
                  "const fName = pm.iterationData.get(\"firstName\");",
                  "const lName = pm.iterationData.get(\"lastName\");",
                  "",
                  "if (isEmptyBody) {",
                  "    // SCENARIO: Send literal empty object {}",
                  "    pm.variables.set(\"dynamicBody\", \"{}\");",
                  "    console.log(\"TEST: Sending Empty Body {}\");",
                  "} else {",
                  "    // 2. Build standard object",
                  "    let body = {",
                  "        \"firstname\": fName,",
                  "        \"lastname\": lName,",
                  "        \"totalprice\": Number(pm.iterationData.get(\"totalPrice\")),",
                  "        \"depositpaid\": String(pm.iterationData.get(\"depositPaid\")).toLowerCase() === \"true\",",
                  "        \"bookingdates\": {",
                  "            \"checkin\": pm.iterationData.get(\"checkin\"),",
                  "            \"checkout\": pm.iterationData.get(\"checkout\")",
                  "        },",
                  "        \"additionalneeds\": pm.iterationData.get(\"additionalNeeds\")",
                  "    };",
                  "",
                  "    // 3. Structural Negative Testing (Key Deletion)",
                  "    if (fName === \"MISSING_FIELD\") delete body.firstname;",
                  "    if (fName === \"MISSING_FIELD\") delete body.lastname;",
                  "    if (fName === \"MISSING_FIELDS\") delete body.bookingdates;",
                  "",
                  "    pm.variables.set(\"dynamicBody\", JSON.stringify(body));",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{dynamicBody}}\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseURL}}/booking",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "booking"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "UpdateBooking",
      "item": [
        {
          "name": "UpdateBooking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const schema = {",
                  "    \"type\": \"object\",",
                  "    \"required\": [\"firstname\", \"lastname\", \"totalprice\", \"depositpaid\", \"bookingdates\"],",
                  "    \"properties\": {",
                  "        \"firstname\": { \"type\": \"string\" },",
                  "        \"lastname\": { \"type\": \"string\" },",
                  "        \"totalprice\": { \"type\": \"number\" },",
                  "        \"depositpaid\": { \"type\": \"boolean\" },",
                  "        \"bookingdates\": {",
                  "            \"type\": \"object\",",
                  "            \"required\": [\"checkin\", \"checkout\"],",
                  "            \"properties\": {",
                  "                \"checkin\": { \"type\": \"string\", \"pattern\": \"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\" },",
                  "                \"checkout\": { \"type\": \"string\", \"pattern\": \"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\" }",
                  "            }",
                  "        },",
                  "        \"additionalneeds\": { \"type\": \"string\" }",
                  "    }",
                  "};",
                  "",
                  "const expectedStatus = Number(pm.iterationData.get(\"expectedStatus\"));",
                  "",
                  "pm.test(`Status is ${expectedStatus}`, () => {",
                  "    pm.response.to.have.status(expectedStatus);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    pm.test(\"Schema Validation for PUT response\", () => {",
                  "        const jsonData = pm.response.json();",
                  "        const result = tv4.validateResult(jsonData, schema);",
                  "        pm.expect(result.valid).to.be.true;",
                  "    });",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// 1. Check for the \"Empty Body\" override first",
                  "const isEmptyBody = String(pm.iterationData.get(\"isEmptyBody\")).toLowerCase() === \"true\";",
                  "",
                  "if (isEmptyBody) {",
                  "    pm.variables.set(\"dynamicBody\", \"{}\");",
                  "    console.log(\"TEST: Sending empty JSON {}\");",
                  "} else {",
                  "    // Define variables once",
                  "    const fName = pm.iterationData.get(\"firstName\");",
                  "    ",
                  "    // 2. Build the Full Body",
                  "    let body = {",
                  "        \"firstname\": fName,",
                  "        \"lastname\": pm.iterationData.get(\"lastName\"),",
                  "        \"totalprice\": Number(pm.iterationData.get(\"totalPrice\")),",
                  "        \"depositpaid\": String(pm.iterationData.get(\"depositPaid\")).toLowerCase() === \"true\",",
                  "        \"bookingdates\": {",
                  "            \"checkin\": pm.iterationData.get(\"checkin\"),",
                  "            \"checkout\": pm.iterationData.get(\"checkout\")",
                  "        },",
                  "        \"additionalneeds\": pm.iterationData.get(\"additionalNeeds\")",
                  "    };",
                  "",
                  "    // 3. Handle MISSING_FIELD logic",
                  "    if (fName === \"MISSING_FIELD\") {",
                  "        delete body.firstname;",
                  "        console.log(\"Negative Test: Removed firstname from payload\");",
                  "    }",
                  "",
                  "    pm.variables.set(\"dynamicBody\", JSON.stringify(body));",
                  "    console.log(\"Sending standard PUT payload\", JSON.stringify(body));",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Cookie",
                "value": "token={{token}}",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "{{authorization}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{dynamicBody}}\n\n// {\n//     \"firstname\" : \"James-r\",\n//     \"lastname\" : \"Brown\",\n//     \"totalprice\" : 111,\n//     \"depositpaid\" : true,\n//     \"bookingdates\" : {\n//         \"checkin\" : \"2018-01-01\",\n//         \"checkout\" : \"2019-01-01\"\n//     },\n//     \"additionalneeds\" : \"Breakfast\"\n// }",
              "options": {
                "raw": {
                  "language": "json"
